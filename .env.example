# Smart Attendance System - Environment Variables Template
# Copy this file to .env or set environment variables in your system.

# Database Configuration
DB_NAME=smart_attendance_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security Key (Must be at least 256 bits / 32 characters)
JWT_SECRET=SmartAttendanceSecretKeyForJWTTokenGenerationMustBeAtLeast256BitsLong2026SecureKey

# Mail Configuration (Optional - for email notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@smartattendance.com

# Server & Frontend Ports
SERVER_PORT=8085
VITE_API_BASE_URL=http://localhost:8085/api/v1
